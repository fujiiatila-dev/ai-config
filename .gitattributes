# Tudo que o instalador copia precisa ter os mesmos bytes em qualquer sistema:
# com core.autocrlf=true, o checkout no Windows trocaria LF por CRLF e cada
# instalação acusaria dezenas de arquivos "diferentes" sem mudança real.
*                                      text=auto eol=lf

# Scripts do Windows mantêm CRLF.
*.cmd                                  text eol=crlf
*.ps1                                  text eol=crlf

# Binários.
*.png                                  binary
*.jpg                                  binary
*.ico                                  binary
*.exe                                  binary
