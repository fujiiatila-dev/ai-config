# Base portátil para o Codex. O instalador do Headroom preenche a configuração
# real em ~/.codex/config.toml sem transportar credenciais ou preferências locais.
model_provider = "headroom"
openai_base_url = "http://127.0.0.1:48731/v1"

[model_providers.headroom]
name = "Headroom local proxy"
base_url = "http://127.0.0.1:48731/v1"
supports_websockets = true
requires_openai_auth = true
