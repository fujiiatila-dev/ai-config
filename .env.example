# Variáveis opcionais. Nunca coloque valores reais aqui nem no repositório.

# Porta do proxy Headroom (padrão 48731).
# HEADROOM_PORT=48731

# Aponte os agentes para o proxy local, quando ele estiver rodando.
# ANTHROPIC_BASE_URL=http://127.0.0.1:48731
# OPENAI_BASE_URL=http://127.0.0.1:48731/v1

# Destinos alternativos para o instalador.
# CLAUDE_CONFIG_DIR=~/.claude
# CODEX_HOME=~/.codex
# GEMINI_HOME=~/.gemini
# RTK_CONFIG_DIR=~/.config/rtk
