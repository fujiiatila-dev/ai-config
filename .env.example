# Variáveis opcionais. Nunca coloque valores reais aqui nem no repositório.

# Porta do proxy Headroom opt-in (padrão 48731).
# HEADROOM_PORT=48731

# Defina estas opções somente no shell que inicia uma sessão Headroom.
# Não persista ANTHROPIC_BASE_URL nem OPENAI_BASE_URL no perfil do usuário.
# HEADROOM_DISABLE_KOMPRESS=1
# HEADROOM_DISABLE_KOMPRESS_FALLBACK=1
# HEADROOM_COMPRESSION_MAX_WORKERS=4

# Destinos alternativos para o instalador.
# CLAUDE_CONFIG_DIR=~/.claude
# CODEX_HOME=~/.codex
# GEMINI_HOME=~/.gemini
# RTK_CONFIG_DIR=~/.config/rtk
