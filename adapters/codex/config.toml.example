# Base portátil para o Codex.
#
# O instalador mescla estas chaves no seu ~/.codex/config.toml: o que não
# existir é adicionado, e o que existir com outro valor gera uma pergunta.
# Credenciais nunca vêm daqui — use variáveis de ambiente ou o login do Codex.
approval_policy = "on-request"
approvals_reviewer = "user"
sandbox_mode = "workspace-write"

[windows]
sandbox = "unelevated"
