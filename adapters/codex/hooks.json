{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "\"{{PYTHON}}\" \"{{CODEX_HOME}}/headroom_healthcheck.py\" --headroom \"{{HEADROOM}}\" --profile init-user --ensure --marker headroom-init-codex",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
